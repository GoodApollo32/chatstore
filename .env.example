# Copy this file to ".env" (same folder) and fill in the values. Never share or commit the .env file.

# --- Ingram Micro (from the Ingram developer portal: My Apps → your app) ---
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
# Your Ingram Micro Canada reseller account number, e.g. 20-123456
INGRAM_CUSTOMER_NUMBER=
INGRAM_COUNTRY_CODE=CA
# "sandbox" for the test app, "production" once Ingram approves the production app.
# The keys must match: sandbox keys only work with sandbox.
INGRAM_ENV=sandbox
# Optional: a short name for your company, sent with each request
INGRAM_SENDER_ID=
# How fast to call Ingram. Raise only once Ingram's published limits are confirmed.
INGRAM_MAX_REQUESTS_PER_SECOND=1

# --- Automatic schedule (off for the prototype; use the "Refresh now" buttons) ---
SCHEDULE_ENABLED=false
SCHEDULE_TIMEZONE=America/Vancouver
SCHEDULE_CATALOG_TIMES=02:00
SCHEDULE_REFRESH_TIMES=06:00,13:00
# For short test windows: also refresh prices & stock every N minutes (leave blank normally)
SCHEDULE_REFRESH_EVERY_MINUTES=

# --- Set automatically when running under Docker; only needed when running without it ---
# DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
